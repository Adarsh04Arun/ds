    "plt.ylabel('internal marks')\n",
    "plt.show()\n",
    "\n",
    "plt.scatter(df[\"attendance\"],df[\"internal_marks\"],alpha=0.7,color='green')\n",
    "plt.xlabel('Attendance')\n",
    "plt.ylabel('internal marks')\n",
    "plt.show()\n",
    "\n",
    "plt.boxplot(df['internal_marks'])\n",
