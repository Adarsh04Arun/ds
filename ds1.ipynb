   "source": [
    "import pandas as pd\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.decomposition import PCA\n",
    "\n",
    "data = {\n",
    "    \"Student_ID\": [\"S1\",\"S2\",\"S3\",\"S4\",\"S5\",\"S6\"],\n",
    "    \"Math\": [78,65,88,55,92,70],\n",
    "    \"Physics\": [72,60,85,58,90,68],\n",
    "    \"Chemistry\": [75,62,82,60,88,72],\n",
    "    \"Programming\": [85,70,90,65,95,75],\n",
    "    \"Aptitude\": [80,68,86,62,90,74]\n",
    "}\n",
    "df = pd.DataFrame(data)\n",
    "x=df.drop(columns=['Student_ID'])\n",
    "scaler = StandardScaler()\n",
    "x_scaled = scaler.fit_transform(x)\n",
    "\n",
    "pca = PCA(n_components=2)\n",
    "pca_componets=pca.fit_transform(x_scaled)\n",
    "\n",
    "print(\"Explained Variance Ratio:\",pca.explained_variance_ratio_)\n",
    "\n",
    "plt.scatter(pca_componets[:,0],pca_componets[:,1])\n",
    "plt.xlabel(\"Principal Component 1\")\n",
    "plt.ylabel(\"Principal Component 2\")\n",
    "plt.title(\"PCA of Student Performance Data\")\n",
    "for i, s in enumerate(df['Student_ID']):\n",
    "    plt.text(pca_componets[i,0], pca_componets[i,1], s)\n",
    "plt.show()"
   ]
