    "plt.show()\n",
    "\n",
    "\n",
    "plt.boxplot(df['internal_marks'])\n",
    "plt.title(\"Boxplot for internal marks\")\n",
    "plt.ylabel(\"marks\")\n",
    "plt.show()\n",
    "\n",
    "df[\"Maths\"] = [75, 88, 62, 85, 70, 92, 60, 78]\n",
    "df[\"Physics\"] = [72, 84, 60, 80, 68, 90, 58, 75]\n",
