    "import numpy as np\n",
    "from scipy.stats import norm\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "np.random.seed(42)\n",
    "score=np.random.normal(70,10,100)\n",
    "hours=np.random.normal(6,2,100)\n",
    "\n",
    "print(\"\\n Stats Summary (Scores)\")\n",
    "print(\"Mean:\",np.mean(score))\n",
    "print(\"Median:\",np.median(score))\n",
    "print(\"Standard Deviation:\",np.std(score))\n",
    "print(\"\\n Stats Summary (Hours)\")\n",
    "print(\"Mean:\",np.mean(hours))\n",
    "print(\"Median:\",np.median(hours))\n",
    "print(\"Standard Deviation:\",np.std(hours))\n",
    "\n",
    "print(\"\\nProbabiblity: \",1-norm.cdf(75,np.mean(score),np.std(score)))\n",
    "\n",
    "\n",
    "plt.hist(score, bins=10,alpha=0.7,color='blue', edgecolor='black')\n",
    "plt.title('Distribution of Scores')\n",
    "plt.xlabel('Scores')\n",
    "plt.ylabel('Frequency')\n",
    "plt.show()\n",
    "\n",
    "plt.scatter(hours,score,alpha=0.7,color='green')\n",
    "plt.title('Study Hours vs Scores')\n",
    "plt.xlabel('Study Hours')\n",
    "plt.ylabel('Scores')\n",
    "plt.show()"
   ]
  },
