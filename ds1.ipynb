    "df[\"Chemistry\"] = [78, 86, 65, 82, 72, 88, 62, 77]\n",
    "\n",
    "subject_marks=df[[\"Maths\",\"Physics\",\"Chemistry\"]]\n",
    "sns.heatmap(subject_marks,annot=True)\n",
    "plt.title(\"Heatmap of student performance across subjects\")\n",
    "plt.xlabel(\"Subjects\")\n",
    "plt.ylabel(\"Students\")\n",
    "plt.show()\n"
   ]
