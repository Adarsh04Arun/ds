    "import pandas as pd\n",
    "from sklearn.naive_bayes import BernoulliNB\n",
    "from sklearn.metrics import accuracy_score\n",
    "\n",
    "# Create dataset\n",
    "data = {\n",
    "    \"Contains_Offer\": [\"Yes\",\"No\",\"Yes\",\"No\",\"Yes\",\"No\"],\n",
    "    \"Contains_Link\": [\"Yes\",\"Yes\",\"Yes\",\"No\",\"No\",\"Yes\"],\n",
    "    \"Contains_Attachment\": [\"No\",\"No\",\"Yes\",\"No\",\"No\",\"Yes\"],\n",
    "    \"Is_Spam\": [\"Spam\",\"Not Spam\",\"Spam\",\"Not Spam\",\"Spam\",\"Not Spam\"]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "df_encoded = df.replace({\n",
    "    \"Yes\":1,\"No\":0,\"Spam\":1,\"Not Spam\":0\n",
    "})\n",
    "\n",
    "x=df_encoded[['Contains_Offer','Contains_Link','Contains_Attachment']]\n",
    "y=df_encoded['Is_Spam']\n",
    "\n",
    "model=BernoulliNB()\n",
    "model.fit(x,y)\n",
    "y_pred=model.predict([[1,0,1]])\n",
    "print(\"Prediction:\" \"Spam\" if y_pred[0]==1 else \"Not Spam\")\n",
    "y_pred=model.predict(x)\n",
    "accuray=accuracy_score(y,y_pred)\n",
    "print(\"Accuracy of Naive Bayes Model:\",accuray)"
   ]
  },
